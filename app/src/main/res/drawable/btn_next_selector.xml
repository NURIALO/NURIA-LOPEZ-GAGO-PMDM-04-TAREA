<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#AA730DBC"/>
            <corners android:radius="40dp"/> <!-- Más alargado y redondeado -->
            <stroke android:width="3dp" android:color="#FFD700"/> <!-- Borde dorado -->
            <padding android:left="20dp" android:right="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#AA730DBC"/>
            <corners android:radius="40dp"/>
            <stroke android:width="3dp" android:color="#FFD700"/>
            <padding android:left="20dp" android:right="20dp"/>
        </shape>
    </item>
</selector>
