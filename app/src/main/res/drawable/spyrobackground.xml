<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo morado sin margen interno -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#886A0DAD"/> <!-- Morado Spyro translúcido -->
            <corners android:radius="25dp"/>
        </shape>
    </item>

    <!-- Borde amarillo sin separación -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="25dp"/>
            <stroke android:width="8dp" android:color="#FFD700"/> <!-- Borde amarillo más grueso -->
        </shape>
    </item>

</layer-list>

